# Добавьте это в ваш .aiexclude

# Исключаем скрытые системные папки (кроме тех, что уже есть)
.*
!.aiexclude

# Исключаем специфические папки тестов, если они не нужны для текущей задачи
**/androidTest/
**/test/

# Исключаем очень длинные XML (часто это ресурсы или манифесты библиотек)
# Если какой-то XML весит больше 50-100 КБ, он может съедать контекст
# (К сожалению, .aiexclude обычно не поддерживает фильтр по размеру,
# но можно исключать конкретные тяжелые папки)

# Исключаем папку с переводами, если она слишком большая
# **/src/main/res/values-*/strings.xml

# Если используете Git, лучше исключить историю
.git/