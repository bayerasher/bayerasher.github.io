<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Dreamnet" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Основной фон приложения — глубокий черный для мистического эффекта -->
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>

        <!-- Настройка системного Splash Screen (Android 12+) -->
        <!-- Делаем фон черным, чтобы убрать белую вспышку при запуске -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#000000</item>
        <!-- Убираем стандартную иконку, заменяя её на прозрачный цвет -->
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@android:color/transparent</item>
    </style>
</resources>
